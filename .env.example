# ---- UniFi camera microphone bridge -----------------------------------------
# RTSP(S) URL of your G4 Instant. Enable RTSP in UniFi Protect:
#   Protect > the camera > Settings > Advanced > RTSP  (tick a resolution)
# Plain RTSP is on port 7447; encrypted RTSPS is on 7441.
#   rtsp://CONSOLE_IP:7447/<streamId>
#   rtsps://CONSOLE_IP:7441/<streamId>?enableSrtp   (use -rtsp_transport tcp, already set)
RTSP_URL="rtsp://CONSOLE_IP:7447/REPLACE_WITH_STREAM_ID"

# Mic sample rate fed to the assistant (LVA expects 16 kHz mono).
MIC_RATE="16000"

# ---- Linux Voice Assistant --------------------------------------------------
LVA_USER_ID="1000"
LVA_USER_GROUP="1000"
CLIENT_NAME="unifi-camera-satellite"

# Bind inside the container; Compose publishes this on the Docker host.
HOST="0.0.0.0"
LVA_PORT="6053"
LVA_PERIPHERAL_PORT="6055"

# Point LVA at the shared PulseAudio socket from the audio-bridge container.
LVA_PULSE_SERVER="unix:/run/pulse/native"
LVA_PULSE_COOKIE="DISABLED"
LVA_XDG_RUNTIME_DIR="/run/pulse"

# Use the camera as the microphone. (Mono, matches the camera.)
AUDIO_INPUT_DEVICE="camera_mic"
AUDIO_INPUT_CHANNELS="1"

# ---- UniFi camera speaker bridge -------------------------------------------
# Exact camera display name in UniFi Protect.
PROTECT_CAMERA="Bonus Room"

# PulseAudio sink whose monitor is sent to the camera speaker.
AUDIO_OUTPUT_DEVICE="pulse/lva_out"
TALKBACK_OUTPUT_MONITOR="lva_out.monitor"

# Optional: enable while troubleshooting.
# ENABLE_DEBUG="1"
# LISTEN_DURING_WAKE_SOUND="1"
# LIST_DEVICES="1"
